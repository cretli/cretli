{
  "name": "cretli",
  "version": "0.2.0",
  "description": "Remote vibe coding from your phone. Self-hosted mobile client and widgets for Cursor SDK, OpenRouter, OpenCode, and AI agents.",
  "type": "module",
  "main": "server.js",
  "license": "MIT",
  "author": "cretli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cretli/cretli.git"
  },
  "homepage": "https://cretli.com",
  "bugs": {
    "url": "https://github.com/cretli/cretli/issues"
  },
  "keywords": [
    "vibe-coding",
    "remote-coding",
    "cursor-ai",
    "mobile-coding",
    "openrouter",
    "ai-agent",
    "developer-tools",
    "self-hosted",
    "terminal",
    "pwa",
    "opencode"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "CURSOR_RIPGREP_PATH=./node_modules/.bin/rg USE_HTTPS=1 bash ./scripts/start-server-node22.sh",
    "start:lan": "CURSOR_RIPGREP_PATH=./node_modules/.bin/rg CRETLI_BIND=0.0.0.0 USE_HTTPS=1 bash ./scripts/start-server-node22.sh",
    "start:no-hmr": "CURSOR_RIPGREP_PATH=./node_modules/.bin/rg CRETLI_FRONT_HMR=0 USE_HTTPS=1 bash ./scripts/start-server-node22.sh",
    "build:front": "npm run dev -w cretli-front",
    "build:front:prod": "npm run build:pwa-icons && npm run build:pwa-screenshots && npm run prod -w cretli-front",
    "build:widget": "npm run build:widget -w cretli-front",
    "build:mdi-subset": "node scripts/build-mdi-subset.mjs",
    "build:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "build:pwa-screenshots": "node scripts/generate-pwa-screenshots.mjs",
    "gen-cert": "node scripts/generate-lan-cert.mjs",
    "test": "node scripts/run-unit-tests.mjs",
    "test:fork-title": "node scripts/test-fork-title.js",
    "test:generate-chat-title": "node scripts/test-generate-chat-title.js",
    "capture:status-flow": "node scripts/capture-status-flow-from-chat.js",
    "test:status-parser": "node tests/status-parser.test.js",
    "test:status-parser:flow": "node tests/status-parser-flow.test.js",
    "test:status-parser:flow:list": "node tests/status-parser-flow.test.js --list",
    "test:bind-host": "node tests/bind-host.test.js",
    "test:harness-status": "node tests/harness-status.test.js",
    "test:optional-cursor-sdk": "node tests/optional-cursor-sdk.test.js",
    "test:sdk-state-resolver": "node tests/sdk-state-resolver.test.js",
    "test:chat-status-meta": "node tests/chat-status-meta.test.js",
    "test:status-parser:all": "npm run test:status-parser && npm run test:status-parser:flow",
    "test:chat-catchup:flow": "node tests/chat-catchup-flow.test.js",
    "test:sdk-chat-history": "node tests/sdk-chat-history.test.js",
    "test:sdk-mode": "node tests/sdk-mode.test.js",
    "test:harness-plan-policy": "node tests/harness-plan-policy.test.js",
    "test:sdk-ui-mode": "node tests/sdk-ui-mode.test.js",
    "test:sdk-event-replay-guard": "node tests/sdk-event-replay-guard.test.js",
    "test:sdk-prompt-images": "node tests/sdk-prompt-images.test.js",
    "test:sdk-thinking-state": "node tests/sdk-thinking-state.test.js",
    "test:sdk-run-idle-guard": "node tests/sdk-run-idle-guard.test.js",
    "test:sdk-context-reset": "node tests/sdk-context-reset.test.js",
    "test:sdk-model-change": "node tests/sdk-model-change.test.js",
    "test:sdk-ws-transport": "node tests/sdk-ws-transport.test.js",
    "test:sdk-room-state": "node tests/sdk-room-state.test.js",
    "test:sdk-transport-labels": "node tests/sdk-transport-labels.test.js",
    "test:sdk-disconnect-replay": "node tests/sdk-disconnect-replay.test.js",
    "test:sdk-setup-retry": "node tests/sdk-setup-retry.test.js",
    "test:sdk-ws-reconnect-smoke": "node tests/sdk-ws-reconnect-smoke.test.js",
    "test:sdk-room-bus": "node tests/sdk-room-bus.test.js",
    "test:sdk-room-registry": "node tests/sdk-room-registry.test.js",
    "test:sdk-remote-room-stub": "node tests/sdk-remote-room-stub.test.js",
    "test:sdk-sticky-session": "node tests/sdk-sticky-session.test.js",
    "test:chat-history-revisions": "node tests/chat-history-revisions.test.js",
    "test:sdk-ws-handshake": "node tests/sdk-ws-handshake.test.js",
    "test:sdk-ws-handshake-e2e": "node tests/sdk-ws-handshake-e2e.test.js",
    "test:openrouter-client": "node tests/openrouter-client.test.js",
    "test:tool-executor": "node tests/tool-executor.test.js",
    "test:chats-persist-harness": "node tests/chats-persist-harness.test.js",
    "test:opencode-event-normalizer": "node tests/opencode-event-normalizer.test.js",
    "test:opencode-api-key": "node tests/opencode-api-key.test.js",
    "test:opencode-prompt-run": "node tests/opencode-prompt-run.test.js",
    "test:opencode-server-manager": "node tests/opencode-server-manager.test.js",
    "test:opencode-harness-flow": "node tests/opencode-harness-flow.test.js",
    "test:opencode-question": "node tests/opencode-question.test.js",
    "test:opencode-permission": "node tests/opencode-permission.test.js",
    "test:opencode-plan-mode": "node tests/opencode-plan-mode.test.js",
    "test:opencode-ws-protocol": "node tests/opencode-ws-protocol.test.js",
    "test:opencode-reconnect": "node tests/opencode-reconnect.test.js",
    "test:opencode-harness-e2e": "npx --yes node@22 scripts/opencode-harness-e2e.mjs",
    "test:e2e:browsers": "PLAYWRIGHT_BROWSERS_PATH=0 NPM_CONFIG_CACHE=./data/npm-cache npx --yes node@22 ./node_modules/playwright/cli.js install chromium",
    "test:e2e": "npm run test:e2e:mock",
    "test:e2e:mock": "PLAYWRIGHT_BROWSERS_PATH=0 NPM_CONFIG_CACHE=./data/npm-cache npx --yes node@22 ./node_modules/playwright/cli.js test --config=playwright.config.js --grep-invert @live",
    "test:e2e:live": "PLAYWRIGHT_BROWSERS_PATH=0 NPM_CONFIG_CACHE=./data/npm-cache CHAT_E2E_LIVE=1 npx --yes node@22 ./node_modules/playwright/cli.js test --config=playwright.config.js --grep @live",
    "test:e2e:live:opencode": "npm run test:opencode-harness-e2e",
    "test:e2e:live:opencode:alpha-free": "PLAYWRIGHT_BROWSERS_PATH=0 NPM_CONFIG_CACHE=./data/npm-cache CHAT_E2E_LIVE=1 CHAT_E2E_OPENCODE_MODEL=opencode/x-preview-f-free npx --yes node@22 ./node_modules/playwright/cli.js test --config=playwright.config.js --grep @opencode-alpha",
    "test:e2e:live:sdk:composer-25-fast": "PLAYWRIGHT_BROWSERS_PATH=0 NPM_CONFIG_CACHE=./data/npm-cache CHAT_E2E_LIVE=1 CHAT_E2E_SDK_FAST_MODEL=composer-2.5::fast=true npx --yes node@22 ./node_modules/playwright/cli.js test --config=playwright.config.js --grep @sdk-composer-fast",
    "test:e2e:live:sdk:recovery": "PLAYWRIGHT_BROWSERS_PATH=0 NPM_CONFIG_CACHE=./data/npm-cache CHAT_E2E_LIVE=1 CHAT_E2E_SDK_RECOVERY=1 CHAT_E2E_SDK_FAST_MODEL=composer-2.5::fast=true CURSOR_REMOTE_SDK_RUN_IDLE_TIMEOUT_MS=1000 CURSOR_REMOTE_SDK_RUN_AUTO_RECOVERY_GRACE_MS=0 npx --yes node@22 ./node_modules/playwright/cli.js test --config=playwright.config.js --grep @sdk-recovery",
    "test:e2e:sdk-contract": "node tests/chat-e2e-sdk-contract.test.js",
    "test:sdk-run-auto-recovery": "node tests/sdk-run-auto-recovery.test.js",
    "test:conversation-fork": "node tests/conversation-fork.test.js",
    "test:context-compression": "node tests/context-compression.test.js",
    "test:theme": "node --test tests/theme.test.js",
    "test:widget": "node --test tests/widget-installations.test.js tests/widget-host-clipboard.test.js tests/page-bridge.test.js tests/page-bridge-client.test.js",
    "test:server-restart-state": "node tests/server-restart-state.test.js",
    "test:chat-store-local-storage": "node tests/chat-store-local-storage.test.js",
    "test:todos-persist": "node tests/todos-persist.test.js",
    "test:todo-plan-sync": "node tests/todo-plan-sync.test.js",
    "test:chat-plan-persist": "node tests/chat-plan-persist.test.js",
    "test:modernization": "node tests/chat-resume-policy.test.js && node tests/chat-ws-reconnect-policy.test.js && node tests/mobile-client.test.js && node tests/pwa-freeze-diagnostics.test.js && node tests/freeze-log-persist.test.js && node tests/ui-freeze-trace.test.js && node tests/chat-server-recovery.test.js && node tests/page-resume-cleanup.test.js && node tests/client-debug-instrumentation.test.js && node tests/client-instance-id.test.js && node tests/client-instance-registry.test.js && node tests/client-instance-commands.test.js && node tests/format-server-uptime.test.js && node tests/strip-ansi.test.js",
    "test:without-cursor-sdk": "npm run test:bind-host && npm run test:optional-cursor-sdk && npm run test:openrouter-client && npm run test:tool-executor && npm run test:opencode-event-normalizer && npm run test:opencode-api-key && npm run test:opencode-server-manager && npm run test:auth-session-persist && npm run test:theme && npm run test:widget",
    "test:auth-session-persist": "node tests/auth-session-persist.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.21",
    "compression": "^1.8.1",
    "express": "^4.21.0",
    "jsonc-parser": "^3.3.1",
    "node-pty": "^1.0.0",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "ws": "^8.20.1"
  },
  "optionalDependencies": {
    "@cursor/sdk": "^1.0.30",
    "opencode-ai": "^1.18.21",
    "redis": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.18.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "subset-font": "^2.5.0",
    "webpack": "^5.105.4",
    "webpack-cli": "^7.0.0",
    "webpack-dev-middleware": "^7.4.5",
    "webpack-hot-middleware": "^2.26.1"
  },
  "workspaces": [
    "app_front"
  ]
}
