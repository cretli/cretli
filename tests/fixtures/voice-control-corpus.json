{
  "version": 1,
  "note": "Expected calls use the flat registry tools (`tool`/`args`) and the target family/action shape (`target`). `tool: null` marks a coverage gap: baseline accuracy skips it, the post-registry run scores `target`. `args` are compared on listed keys only (case/diacritic-insensitive substring match); an entry with `argsAny` passes when any listed alternative matches, which keeps inherently ambiguous spoken input scorable. `--validate` also checks that every expected arg key exists in the tool schema and that enum values are legal.",
  "utterances": [
    { "id": "u01", "lang": "en", "text": "Tell the agent to add a unit test for the parser.", "tool": "send_prompt", "args": { "text": "unit test parser" }, "target": { "family": "core", "action": "send_prompt" } },
    { "id": "u02", "lang": "pl", "text": "Powiedz agentowi, żeby dodał test jednostkowy do parsera.", "tool": "send_prompt", "args": { "text": "test parser" }, "target": { "family": "core", "action": "send_prompt" } },
    { "id": "u03", "lang": "en", "text": "Stop the agent.", "tool": "stop_agent", "args": {}, "target": { "family": "core", "action": "stop_agent" } },
    { "id": "u04", "lang": "pl", "text": "Przerwij to, co robi agent.", "tool": "stop_agent", "args": {}, "target": { "family": "core", "action": "stop_agent" } },
    { "id": "u05", "lang": "en", "text": "What did the agent say?", "tool": "read_last_answer", "args": {}, "target": { "family": "core", "action": "read_last_answer" } },
    { "id": "u06", "lang": "pl", "text": "Przeczytaj ostatnią odpowiedź.", "tool": "read_last_answer", "args": {}, "target": { "family": "core", "action": "read_last_answer" } },
    { "id": "u07", "lang": "en", "text": "Is the agent still running?", "tool": "get_chat_status", "args": {}, "target": { "family": "core", "action": "get_status" } },
    { "id": "u08", "lang": "pl", "text": "Jaki model jest teraz w tym czacie?", "tool": "get_chat_status", "args": {}, "target": { "family": "core", "action": "get_status" } },
    { "id": "u09", "lang": "en", "text": "Which chats do I have open?", "tool": "list_chats", "args": {}, "target": { "family": "chat", "action": "list" } },
    { "id": "u10", "lang": "pl", "text": "Przełącz na czat „Refaktoryzacja żądań”.", "tool": "switch_chat", "args": { "title": "Refaktoryzacja żądań" }, "target": { "family": "chat", "action": "switch", "args": { "title": "Refaktoryzacja żądań" } }, "tags": ["diacritics"] },
    { "id": "u11", "lang": "pl", "text": "Wróć do czatu Zażółć gęślą jaźń.", "tool": "switch_chat", "args": { "title": "Zażółć gęślą jaźń" }, "target": { "family": "chat", "action": "switch" }, "tags": ["diacritics"] },
    { "id": "u12", "lang": "en", "text": "Switch to chat number three.", "tool": "switch_chat", "argsAny": [{ "title": "3" }, { "title": "three" }], "target": { "family": "chat", "action": "switch" }, "tags": ["ambiguous"] },
    { "id": "u13", "lang": "en", "text": "Delete this chat.", "tool": "delete_chat", "args": {}, "target": { "family": "chat", "action": "delete", "risk": "confirm" }, "tags": ["confirm"] },
    { "id": "u14", "lang": "pl", "text": "Zamknij ten czat, ale go nie usuwaj.", "tool": "close_chat", "args": {}, "target": { "family": "chat", "action": "close" }, "tags": ["ambiguous"] },
    { "id": "u15", "lang": "en", "text": "Create a new chat in the libs workspace.", "tool": "create_chat", "args": { "workspace": "libs" }, "target": { "family": "chat", "action": "create" } },
    { "id": "u16", "lang": "pl", "text": "Załóż nowy czat w projekcie sklep.", "tool": "create_chat", "args": { "workspace": "sklep" }, "target": { "family": "chat", "action": "create" } },
    { "id": "u17", "lang": "en", "text": "Show me the sidebar.", "tool": "open_chat_sidebar", "args": {}, "target": { "family": "panel", "action": "open", "args": { "panel": "sidebar" } } },
    { "id": "u18", "lang": "pl", "text": "Schowaj panel boczny.", "tool": "close_chat_sidebar", "args": {}, "target": { "family": "panel", "action": "close", "args": { "panel": "sidebar" } } },
    { "id": "u19", "lang": "en", "text": "Switch to plan mode.", "tool": "set_chat_mode", "args": { "mode": "plan" }, "target": { "family": "chat", "action": "set_mode" } },
    { "id": "u20", "lang": "pl", "text": "Przełącz na tryb agenta.", "tool": "set_chat_mode", "args": { "mode": "agent" }, "target": { "family": "chat", "action": "set_mode" } },
    { "id": "u21", "lang": "en", "text": "Run the build task.", "tool": "run_task", "args": { "label": "build" }, "target": { "family": "tasks", "action": "run" } },
    { "id": "u22", "lang": "pl", "text": "Jakie zadania są dostępne?", "tool": "list_tasks", "args": {}, "target": { "family": "tasks", "action": "list" } },
    { "id": "u23", "lang": "en", "text": "Which projects do I have?", "tool": "list_workspaces", "args": {}, "target": { "family": "workspace", "action": "list" } },
    { "id": "u24", "lang": "pl", "text": "Przejdź do projektu libs.", "tool": "switch_workspace", "args": { "workspace": "libs" }, "target": { "family": "workspace", "action": "switch" } },
    { "id": "u25", "lang": "en", "text": "Switch to the docs folder.", "tool": "switch_folder", "args": { "folder": "docs" }, "target": { "family": "workspace", "action": "switch_folder" } },
    { "id": "u26", "lang": "pl", "text": "Jakie foldery są w tym projekcie?", "tool": "list_folders", "args": {}, "target": { "family": "workspace", "action": "list_folders" } },
    { "id": "u27", "lang": "en", "text": "Rename this chat to API cleanup.", "tool": "rename_chat", "args": { "title": "API cleanup" }, "target": { "family": "chat", "action": "rename" } },
    { "id": "u28", "lang": "pl", "text": "Zmień nazwę tego czatu na Łączenie gałęzi.", "tool": "rename_chat", "args": { "title": "Łączenie gałęzi" }, "target": { "family": "chat", "action": "rename" }, "tags": ["diacritics"] },
    { "id": "u29", "lang": "en", "text": "Yes, allow it once.", "tool": "send_nav", "args": { "key": "y" }, "target": { "family": "approval", "action": "once" } },
    { "id": "u30", "lang": "pl", "text": "Nie, odrzuć.", "tool": "send_nav", "args": { "key": "n" }, "target": { "family": "approval", "action": "reject" }, "tags": ["ambiguous"] },
    { "id": "u31", "lang": "en", "text": "Change the model to Grok 4.6.", "tool": "set_model", "args": { "model": "grok" }, "target": { "family": "chat", "action": "set_model" } },
    { "id": "u32", "lang": "pl", "text": "Jakie modele są dostępne dla GPT?", "tool": "list_models", "args": { "query": "gpt" }, "target": { "family": "chat", "action": "list_models" } },
    { "id": "u33", "lang": "en", "text": "Move this to the Codex harness.", "tool": "switch_harness", "args": { "harness": "codex" }, "target": { "family": "chat", "action": "switch_harness", "risk": "confirm" }, "tags": ["confirm"] },
    { "id": "u34", "lang": "pl", "text": "Rozwidl ten czat.", "tool": "fork_chat", "args": {}, "target": { "family": "chat", "action": "fork" } },
    { "id": "u35", "lang": "en", "text": "Read answers out loud sentence by sentence.", "tool": "set_read_mode", "args": { "mode": "stream" }, "target": { "family": "settings", "action": "set_read_mode" } },
    { "id": "u36", "lang": "pl", "text": "Ile kosztuje ta sesja głosowa?", "tool": "get_cost", "args": {}, "target": { "family": "core", "action": "get_cost" } },
    { "id": "u37", "lang": "pl", "text": "Zakończ tryb głosowy.", "tool": "end_voice_mode", "args": {}, "target": { "family": "core", "action": "end_voice_mode" } },
    { "id": "u38", "lang": "en", "text": "Open the git panel and show me the status.", "tool": "panel", "target": { "family": "panel", "action": "open", "args": { "panel": "git" } }, "args": { "action": "open", "panel": "git" } },
    { "id": "u39", "lang": "pl", "text": "Pokaż moje zadania todo.", "tool": null, "target": { "family": "todo", "action": "list" }, "tags": ["gap"] },
    { "id": "u40", "lang": "en", "text": "What are the watcher findings waiting for review?", "tool": "app_status", "target": { "family": "watcher", "action": "list_findings" }, "args": { "action": "scout" } },
    { "id": "u41", "lang": "pl", "text": "Czy któryś harness ma problem z połączeniem?", "tool": "app_status", "target": { "family": "status", "action": "harness_health" }, "tags": ["diacritics"], "args": { "action": "health" } },
    { "id": "u42", "lang": "en", "text": "Show unread notifications.", "tool": "app_status", "target": { "family": "notifications", "action": "list" }, "args": { "action": "notifications" } },
    { "id": "u43", "lang": "pl", "text": "Znajdź czat, w którym rozmawialiśmy o migracji bazy.", "tool": null, "target": { "family": "chat", "action": "search", "args": { "query": "migracji bazy" } }, "tags": ["gap", "diacritics"] },
    { "id": "u44", "lang": "en", "text": "Start the todo about voice coverage.", "tool": null, "target": { "family": "todo", "action": "start", "risk": "confirm" }, "tags": ["gap", "confirm"] },
    { "id": "u45", "lang": "pl", "text": "Zrób to.", "tool": null, "target": { "family": null, "action": "clarify" }, "tags": ["ambiguous", "no_call"] },
    { "id": "u46", "lang": "pl", "text": "Otwórz panel plików.", "tool": "panel", "args": { "action": "open", "panel": "files" }, "target": { "family": "panel", "action": "open" }, "tags": ["diacritics"] },
    { "id": "u47", "lang": "en", "text": "Which panel is open right now?", "tool": "panel", "args": { "action": "status" }, "target": { "family": "panel", "action": "status" } },
    { "id": "u48", "lang": "pl", "text": "Włącz ciemny motyw.", "tool": "app_settings", "args": { "action": "theme", "value": "dark" }, "target": { "family": "app_settings", "action": "theme" }, "tags": ["diacritics"] },
    { "id": "u49", "lang": "en", "text": "Change the interface language to Polish.", "tool": "app_settings", "args": { "action": "language", "value": "pl" }, "target": { "family": "app_settings", "action": "language" } },
    { "id": "u50", "lang": "pl", "text": "Wycisz mikrofon.", "tool": "app_settings", "args": { "action": "mic", "value": "mute" }, "target": { "family": "app_settings", "action": "mic" } },
    { "id": "u51", "lang": "pl", "text": "Ile mam nieprzeczytanych powiadomień?", "tool": "app_status", "args": { "action": "notifications" }, "target": { "family": "app_status", "action": "notifications" }, "tags": ["diacritics"] },
    { "id": "u52", "lang": "en", "text": "How full is the context window of this chat?", "tool": "app_status", "args": { "action": "context" }, "target": { "family": "app_status", "action": "context" } },
    { "id": "u53", "lang": "en", "text": "Which permission requests are waiting?", "tool": "approval", "args": { "action": "describe_pending" }, "target": { "family": "approval", "action": "describe_pending" } },
    { "id": "u54", "lang": "pl", "text": "Jakie prośby o uprawnienia czekają?", "tool": "approval", "args": { "action": "describe_pending" }, "target": { "family": "approval", "action": "describe_pending" }, "tags": ["diacritics"] },
    { "id": "u55", "lang": "en", "text": "Allow this permission request once.", "tool": "approval", "args": { "action": "answer", "answer": "once" }, "target": { "family": "approval", "action": "answer" } },
    { "id": "u56", "lang": "pl", "text": "Odrzuć tę prośbę o uprawnienia.", "tool": "approval", "args": { "action": "answer", "answer": "reject" }, "target": { "family": "approval", "action": "answer" }, "tags": ["diacritics"] },
    { "id": "u57", "lang": "en", "text": "Always allow this tool from now on.", "tool": null, "target": { "family": null, "action": "clarify" }, "tags": ["no_call"] },
    { "id": "u58", "lang": "pl", "text": "Zawsze zezwalaj na to narzędzie.", "tool": null, "target": { "family": null, "action": "clarify" }, "tags": ["no_call", "diacritics"] },
    { "id": "u59", "lang": "en", "text": "Which todos are ready to start?", "tool": "work", "args": {"action": "todo_ready"}, "target": { "family": "work", "action": "todo_ready" } },
    { "id": "u60", "lang": "pl", "text": "Jakie zadania są gotowe do startu?", "tool": "work", "args": {"action": "todo_ready"}, "target": { "family": "work", "action": "todo_ready" }, "tags": ["diacritics"] },
    { "id": "u61", "lang": "en", "text": "What is the status of the login todo?", "tool": "work", "args": {"action": "todo_status", "query": "login"}, "target": { "family": "work", "action": "todo_status" } },
    { "id": "u62", "lang": "pl", "text": "Jaki jest status zadania naprawić logowanie?", "tool": "work", "args": {"action": "todo_status", "query": "logowanie"}, "target": { "family": "work", "action": "todo_status" }, "tags": ["diacritics"] },
    { "id": "u63", "lang": "en", "text": "Start the dark theme todo.", "tool": "work", "args": {"action": "todo_start", "query": "dark theme"}, "target": { "family": "work", "action": "todo_start" } },
    { "id": "u64", "lang": "pl", "text": "Uruchom zadanie z motywem ciemnym.", "tool": "work", "args": {"action": "todo_start", "query": "ciemnym"}, "target": { "family": "work", "action": "todo_start" }, "tags": ["diacritics"] },
    { "id": "u65", "lang": "en", "text": "What is the watcher doing?", "tool": "work", "args": {"action": "watcher_status"}, "target": { "family": "work", "action": "watcher_status" } },
    { "id": "u66", "lang": "pl", "text": "Wstrzymaj watchera.", "tool": "work", "args": {"action": "watcher_pause"}, "target": { "family": "work", "action": "watcher_pause" }, "tags": ["diacritics"] },
    { "id": "u67", "lang": "en", "text": "Resume the watcher.", "tool": "work", "args": {"action": "watcher_resume"}, "target": { "family": "work", "action": "watcher_resume" } },
    { "id": "u68", "lang": "pl", "text": "Wznów watchera.", "tool": "work", "args": {"action": "watcher_resume"}, "target": { "family": "work", "action": "watcher_resume" }, "tags": ["diacritics"] },
    { "id": "u69", "lang": "en", "text": "Which delegations are running?", "tool": "work", "args": {"action": "delegation_status"}, "target": { "family": "work", "action": "delegation_status" } },
    { "id": "u70", "lang": "pl", "text": "Anuluj tę delegację.", "tool": "work", "args": {"action": "delegation_cancel"}, "target": { "family": "work", "action": "delegation_cancel" }, "tags": ["diacritics"] },
    { "id": "u71", "lang": "en", "text": "Approve the plan for this todo.", "tool": null, "target": { "family": null, "action": "clarify" }, "tags": ["no_call"] },
    { "id": "u72", "lang": "pl", "text": "Zatwierdź plan tego zadania.", "tool": null, "target": { "family": null, "action": "clarify" }, "tags": ["no_call", "diacritics"] }
  ]
}
