{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "defaults", "scenarios"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "defaults": {
      "type": "object",
      "required": ["mode", "connection", "agent", "recentOutput"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["append", "replace"] },
        "connection": {
          "type": "string",
          "enum": ["connected", "connecting", "reconnecting", "disconnected"]
        },
        "agent": { "type": "string", "enum": ["active", "idle", "disconnected"] },
        "recentOutput": { "type": "boolean" }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["group", "id", "name", "steps"],
        "additionalProperties": false,
        "properties": {
          "group": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "assumptions": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": { "type": "string", "enum": ["append", "replace"] },
              "connection": {
                "type": "string",
                "enum": ["connected", "connecting", "reconnecting", "disconnected"]
              },
              "agent": { "type": "string", "enum": ["active", "idle", "disconnected"] },
              "recentOutput": { "type": "boolean" }
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "input", "ensures"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "mode": { "type": "string", "enum": ["append", "replace"] },
                "input": { "type": "string" },
                "connection": {
                  "type": "string",
                  "enum": ["connected", "connecting", "reconnecting", "disconnected"]
                },
                "agent": { "type": "string", "enum": ["active", "idle", "disconnected"] },
                "recentOutput": { "type": "boolean" },
                "ensures": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["path", "equals"],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "enum": ["state.tone", "parsed.generating", "parsed.awaiting"]
                      },
                      "equals": {}
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
