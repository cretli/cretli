    "markdown-it": "^15.0.1",
    "mermaid": "^11.16.0"
  },
  "scripts": {
    "build": "node scripts/webpack-cli-watch.mjs --config webpack.prod.js --no-watch",
    "build:dev": "node scripts/webpack-cli-watch.mjs --config webpack.dev.js --no-watch",
    "watch:front": "node scripts/webpack-cli-watch.mjs --config webpack.dev.js",
    "watch:widget": "node scripts/webpack-cli-watch.mjs --config webpack.widget.dev.js",
    "dev": "npm run watch:front",
    "dev:widget": "npm run watch:widget",
    "build:widget": "webpack --config webpack.widget.dev.js --no-watch",
    "prod": "node scripts/webpack-cli-watch.mjs --config webpack.prod.js --no-watch"
