    "esbuild-loader": "^4.5.0",
    "mini-css-extract-plugin": "^2.10.1",
    "sass": "^1.69.0",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "webpack": "^5.110.3",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@lit-labs/signals": "0.3.0",
