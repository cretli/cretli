{
  // Shared typecheck settings (see docs/ts-migration-and-core-harnesses-plan.md, A0).
  // Type-check only: Node strips types natively, the front goes through webpack.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "maxNodeModuleJsDepth": 0
  }
}
