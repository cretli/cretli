# Dependencies
node_modules/
app_front/node_modules/

# Runtime data (secrets, sessions, chats, certs, uploads)
data/
# Accidental local fixtures under lib/ (must not be committed)
lib/data/

# SDK API key files (do not commit)
.cursor-remote-sdk.env
.cretli-sdk.env

# Env / secrets
.env
.env.*
!.env.example
!.cretli-sdk.env.example
*.pem
*.key
*.crt

# Build artifacts
public/dist/
app_front/dist/
# Icon font subset generated by scripts/build-mdi-subset.mjs
app_front/css/generated/
playwright-report/
test-results/
.tmp/

# Local OpenCode reference (see scripts/setup-opencode-reference.sh)
.vendor/opencode/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/tasks.json
!.vscode/extensions.json
