# Cretli — environment variables
# Copy to `.env` (or export individually). All values are optional unless noted.

# --- Server ---
PORT=3011
# Bind host. Default 127.0.0.1 (localhost only). Use 0.0.0.0 to expose on LAN.
# LAN without a password requires CRETLI_SETUP_TOKEN (first-run race protection).
CRETLI_BIND=127.0.0.1
# Legacy alias still supported:
# CURSOR_REMOTE_BIND=127.0.0.1
# Enable HTTPS (self-signed cert in data/). Default is 1 when unset.
# `USE_HTTPS=0 npm start` keeps HTTP; npm scripts no longer force USE_HTTPS=1.
USE_HTTPS=1
# When USE_HTTPS=1, missing or invalid TLS files stop startup (no HTTP fallback).
# Custom SSL_KEY_PATH / SSL_CERT_PATH are used as-is and are not auto-generated.
SSL_KEY_PATH=data/key.pem
SSL_CERT_PATH=data/cert.pem
# IP for the self-signed cert (scripts/generate-ssl-cert.js) when accessing by LAN IP.
# SSL_IP=192.168.1.5

# --- Workspace ---
# Path to a .code-workspace file. If omitted, searches the parent directory.
# WORKSPACE_FILE=/path/to/my.code-workspace
# Default workspace file name to look for (findWorkspaceFile).
# WORKSPACE_FILE_NAME=my-project.code-workspace
# Directory scanned for .code-workspace files (used by /api/workspaces).
# WORKSPACES_SCAN_DIR=/home/me/projects

# --- Cursor SDK (chat) ---
# Cursor API key for @cursor/sdk. Alternatively set it in the app Settings UI.
# CURSOR_API_KEY=
# Default model id for SDK chats.
# CURSOR_SDK_DEFAULT_MODEL=auto

# --- OpenRouter (chat harness) ---
# OpenRouter API key for OpenRouter agent chats. Alternatively set in Settings UI.
# OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers.
# OPENROUTER_SITE_URL=https://example.com
# OPENROUTER_APP_TITLE=Cretli
# --- OpenCode (chat harness) ---
# Auth via CLI on the server (not Cretli settings):
#   opencode auth login
# opencode.json in project or ~/.config/opencode/
# ZHIPU_API_KEY=...   # optional env for Z.ai providers
# OPENCODE_API_KEY=   # OpenCode Zen key (opencode.ai/zen) — auto-configures provider "opencode"
# OPENCODE_BIN=       # optional path to opencode binary (directory added to PATH)
# OPENCODE_PORT_BASE=4096
# OPENCODE_START_TIMEOUT_MS=120000
# HOME override when the process UID is not 0 but HOME points at /root (optional).
# CRETLI_RUNTIME_HOME=

# --- Voice (read-aloud, dictation, voice mode) ---
# OpenAI key for the voice layer. The browser TTS engine needs nothing; this key
# enables OpenAI TTS, server-side transcription and the Realtime voice mode.
# Alternatively set it in the Settings UI. It never leaves the server.
# OPENAI_API_KEY=
# Model and voice overrides (defaults shown).
# CRETLI_VOICE_TTS_MODEL=gpt-4o-mini-tts
# CRETLI_VOICE_TTS_VOICE=alloy
# CRETLI_VOICE_STT_MODEL=gpt-4o-mini-transcribe
# CRETLI_REALTIME_MODEL=gpt-realtime-2.1-mini
# CRETLI_REALTIME_VOICE=marin
# Gemini Live (cheapest continuous conversation). Key from aistudio.google.com/apikey.
# GEMINI_API_KEY=
# CRETLI_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Azure Speech: the only read-aloud engine here with native pl-PL narrators
# (Agnieszka, Marek, Zofia). Both values are required - the region is part of the
# endpoint host. Alternatively set them in the Settings UI.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=westeurope
# CRETLI_AZURE_TTS_VOICE=pl-PL-AgnieszkaNeural
# Per-IP throttle for the OpenAI-backed voice endpoints (requests per minute).
# Unset or 0 = off. Set it whenever Cretli is reachable from the LAN.
# CRETLI_RATELIMIT_OPENAI_PER_MIN=20

# --- Cursor CLI (terminal agents, tasks, scheduled runs) ---
CURSOR_AGENT_CMD=agent
# Model id passed to the CLI (--model). Empty = omit --model.
CURSOR_AGENT_MODEL=auto
# Derive chat title from content via `agent --print --output-format json`.
# CURSOR_AGENT_TITLE_PRINT=1

# --- LAN / URL ---
# Host shown in the in-app link/QR (overrides auto-detected IP and data/config.json).
# LAN_HOST=192.168.1.10
# CRETLI_LAN_HOST=192.168.1.10
# CURSOR_REMOTE_LAN_HOST=192.168.1.10
# Extra browser Origins allowed for authenticated WebSocket upgrades (comma-separated full
# origins, e.g. https://other.example:8443). Host-only entries are ignored. Does not bypass
# login, widget token checks, or chat scope rules. Do not use this list to mark the Cretli
# iframe as first-party — set CRETLI_PUBLIC_ORIGIN instead.
# CRETLI_EXTRA_WS_ORIGINS=https://other.example:8443
# Public origin of this Cretli instance when a reverse proxy terminates TLS (full origin).
# Used to recognize the Cretli iframe behind HTTPS while the Node process still speaks HTTP.
# Forwarded headers are ignored. Widget tokens and chat scope still apply.
# CRETLI_PUBLIC_ORIGIN=https://cretli.example:443

# --- Auth & agent callbacks ---
# Optional one-time setup token. Required when CRETLI_BIND is not localhost
# and no password exists yet (so nobody else on the network can claim setup).
# Header X-Setup-Token, query ?token=, or JSON body setupToken.
# CRETLI_SETUP_TOKEN=long-random-setup-secret
# CURSOR_REMOTE_SETUP_TOKEN=long-random-setup-secret
# Token required for agent callback endpoints (/api/set-*-from-agent) when called
# from a non-localhost source. Localhost callbacks (agent CLI on the same host)
# are always trusted WITHOUT a token, so this token is normally not needed and is
# NOT embedded in agent prompts (to avoid leaking it to Cursor Cloud).
# AGENT_CALLBACK_TOKEN=long-random-secret

# --- Frontend (HMR) ---
# Enable HMR (webpack-dev-middleware + hot middleware). Default on unless NODE_ENV=production.
# CRETLI_FRONT_HMR=1
# CURSOR_REMOTE_FRONT_HMR=1
# Legacy fallback hot-update over /ws-front-build (default off).
# CRETLI_FRONT_HOT_FALLBACK=0
# CURSOR_REMOTE_FRONT_HOT_FALLBACK=0
# Agent PTY size (cols/rows). Narrower = more line wraps in TUI.
# CRETLI_AGENT_COLS=200
# CRETLI_AGENT_ROWS=40
# CURSOR_REMOTE_AGENT_COLS=200
# CURSOR_REMOTE_AGENT_ROWS=40

# --- Sessions / sync ---
# Share one terminal session across clients (default off — each client gets its own).
# TERMINAL_SESSION_SYNC=1

# --- Debug ---
# Log HTTP request timing.
# CRETLI_DEBUG_HTTP_TIMING=0
# CURSOR_REMOTE_DEBUG_HTTP_TIMING=0

# --- E2E (Playwright live chat) ---
# CHAT_E2E_LIVE=1
# CHAT_E2E_PASSWORD=chat-e2e-pass-123
# CHAT_E2E_OPENCODE_MODEL=opencode/x-preview-f-free
# CHAT_E2E_SDK_FAST_MODEL=composer-2.5::fast=true
# CHAT_E2E_SDK_RECOVERY=1
# CHAT_E2E_WORKSPACE_FOLDER=/path/to/this/repo
# CHAT_E2E_LIVE_TIMEOUT_MS=180000
# CHAT_E2E_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium
# CRETLI_SDK_RUN_IDLE_TIMEOUT_MS=1000
# CURSOR_REMOTE_SDK_RUN_IDLE_TIMEOUT_MS=1000
# CURSOR_REMOTE_SDK_RUN_AUTO_RECOVERY_GRACE_MS=0
